<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The core syncs through a relay, so INTERNET is not optional.
         POST_NOTIFICATIONS arrives with AR-1b.3, in the same commit as the
         screen that asks for it: a permission declared before anything can
         use it is a promise with nothing behind it. A refusal is an ordinary
         state — the node still syncs and the log is still the truth. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- AR-1c: the "stay connected" MODE. remoteMessaging rather than
         dataSync, deliberately — Android 15 caps background dataSync at six
         hours a day, and a mode whose whole purpose is being reachable would
         go quiet in the evening with nothing to show for it. remoteMessaging
         describes carrying messages between devices, which is what this is.

         Still no FCM: waking a phone that is not holding a connection is
         AR-1d, with its own contract. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />

    <application
        android:name=".QuietApp"
        android:label="Quiet"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <!-- The product screen, in EVERY variant. Cleartext is loopback only:
             the interface is served by our own node over 127.0.0.1, which is
             also why the WebView is pinned to that origin.

             singleTask because a notification tap must reach the SAME process
             and the same runtime through onNewIntent rather than stacking a
             second Activity over a node that is already open. -->
        <activity
            android:name=".QuietActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- NOT exported: it is started by this app, from a visible screen,
             after a person asked for it. Nothing outside has any business
             switching on a mode that spends their battery. -->
        <service
            android:name=".AvailabilityService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <!-- The swipe, coming back. NOT exported: nothing outside this app has
             any business telling it a notification was cleared, and an
             exported receiver here would let another app clear a person's
             live aggregation from outside. -->
        <receiver
            android:name=".NotificationDismissReceiver"
            android:exported="false" />

    </application>

    <!-- AR-0's rig — RigActivity and the :contender process — lives in
         src/debug/AndroidManifest.xml. It is a MEASUREMENT surface: an
         intent-driven control channel that starts a node on command, and a
         second process that deliberately fights for the data-dir lock.
         Correct for a gate; neither belongs in a shipped application. Keeping
         them in the debug variant makes that structural rather than a note. -->
</manifest>
