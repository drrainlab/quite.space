<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The core syncs through a relay, so INTERNET is not optional.
         POST_NOTIFICATIONS is deliberately ABSENT: AR-1b.2 decides what would
         be shown and shows nothing, and the permission arrives with AR-1b.3 —
         the commit that also asks for it at a moment a person can understand
         and treats a refusal as an ordinary state rather than a startup error.
         A permission declared before anything can use it is a promise with
         nothing behind it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- No foreground service and no FCM: AR-1c and AR-1d, each with its own
         honest battery contract. -->

    <application
        android:name=".QuietApp"
        android:label="Quiet"
        android:allowBackup="false"
        android:usesCleartextTraffic="true" />

    <!-- AR-0's rig — RigActivity and the :contender process — lives in
         src/debug/AndroidManifest.xml. It is a MEASUREMENT surface: an
         intent-driven control channel that starts a node on command, and a
         second process that deliberately fights for the data-dir lock.
         Correct for a gate; neither belongs in a shipped application. Keeping
         them in the debug variant makes that structural rather than a note. -->
</manifest>
