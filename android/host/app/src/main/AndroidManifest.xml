<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The core syncs through a relay, so INTERNET is not optional.
         POST_NOTIFICATIONS arrives with AR-1b.3, in the same commit as the
         screen that asks for it: a permission declared before anything can
         use it is a promise with nothing behind it. A refusal is an ordinary
         state — the node still syncs and the log is still the truth. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice messages. Asked for at the moment the record button is pressed,
         not at launch, and never held: the WebView's getUserMedia is denied
         until this is granted (see QuietActivity.onPermissionRequest). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- AND THIS ONE, WHICH IS NOT OPTIONAL AND IS NOT ABOUT SETTINGS.
         Chromium's Android audio manager refuses to enumerate ANY input
         device unless the app holds both: "Requires MODIFY_AUDIO_SETTINGS
         and RECORD_AUDIO. No audio device will be available for recording."
         With RECORD_AUDIO alone and granted, getUserMedia still failed —
         NotReadableError, which reads as broken hardware and sent the whole
         investigation at the permission the person had already given. It is
         an install-time permission: nobody is asked anything. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- The radio arrives on a USB-OTG cable. NOT required: a phone with no
         host mode is an ordinary phone that reaches people over the internet
         and the local network, and it must still be able to install this. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- AR-1c: the "stay connected" MODE. remoteMessaging rather than
         dataSync, deliberately — Android 15 caps background dataSync at six
         hours a day, and a mode whose whole purpose is being reachable would
         go quiet in the evening with nothing to show for it. remoteMessaging
         describes carrying messages between devices, which is what this is.

         Still no FCM: waking a phone that is not holding a connection is
         AR-1d, with its own contract. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />

    <!-- android:label is the name under the icon, and it is the PRODUCT's
         rather than the project's: the interface says quite.space in its own
         header, and a launcher that said something else would be a second
         name for one thing. -->
    <application
        android:name=".QuietApp"
        android:label="quite.space"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <!-- The product screen, in EVERY variant. Cleartext is loopback only:
             the interface is served by our own node over 127.0.0.1, which is
             also why the WebView is pinned to that origin.

             singleTask because a notification tap must reach the SAME process
             and the same runtime through onNewIntent rather than stacking a
             second Activity over a node that is already open. -->
        <activity
            android:name=".QuietActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- NOT exported: it is started by this app, from a visible screen,
             after a person asked for it. Nothing outside has any business
             switching on a mode that spends their battery. -->
        <service
            android:name=".AvailabilityService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <!-- The swipe, coming back. NOT exported: nothing outside this app has
             any business telling it a notification was cleared, and an
             exported receiver here would let another app clear a person's
             live aggregation from outside. -->
        <receiver
            android:name=".NotificationDismissReceiver"
            android:exported="false" />

    </application>

    <!-- AR-0's rig — RigActivity and the :contender process — lives in
         src/debug/AndroidManifest.xml. It is a MEASUREMENT surface: an
         intent-driven control channel that starts a node on command, and a
         second process that deliberately fights for the data-dir lock.
         Correct for a gate; neither belongs in a shipped application. Keeping
         them in the debug variant makes that structural rather than a note. -->
</manifest>
