<?xml version="1.0" encoding="utf-8"?>
<!--
  AR-0's measurement rig, and it exists ONLY in the debug variant.

  Everything here is a control surface for a gate rather than a product
  component: an Activity that starts and stops a node on an intent, and a
  second process whose entire job is to be refused the data-dir lock. Merged
  into a release build they would be an exported remote-control and a process
  that provokes the failure the lock exists to prevent.

  The rig's Java is likewise frozen: src/debug/java holds exactly what AR-0
  measured. Porting a finished measurement artifact to a new language changes
  what the numbers describe and buys nothing.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The debug build wears a different name ON PURPOSE, and the merger has
         to be told so explicitly: a rig and a product that look identical in
         the launcher is how a measurement gets taken against the wrong one. -->
    <application
        android:label="Quiet AR-0 rig"
        tools:replace="android:label">

        <!-- singleTask so a second `am start` reaches the SAME process through
             onNewIntent rather than stacking a second one. The rig's identity
             claim is about one process; two would make core_pid meaningless.

             It deliberately does NOT finish(): a real app backgrounded by HOME
             keeps an activity in its task, and a rig that finished would leave
             the process component-less and therefore first in line for the
             low-memory killer — a harsher lifecycle than the product's, which
             would make background -> return fail for a reason that is ours.

             NO LAUNCHER CATEGORY ANY MORE. The product screen is what a person
             opens, in every variant, and two launcher icons in a debug build
             is how a measurement gets taken against the wrong one. The harness
             never needed it: it addresses the component explicitly, as
             `am start -n <pkg>/.RigActivity`. -->
        <activity
            android:name=".RigActivity"
            android:exported="true"
            android:launchMode="singleTask" />

        <!-- The second process, for the one assertion that cannot be made by a
             second call: two PROCESSES under one app UID opening one data
             directory. Without a real separate process, "the data-dir lock
             holds on Android" would be a claim with no mechanism behind it. -->
        <activity
            android:name=".ContenderActivity"
            android:exported="true"
            android:process=":contender"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

    </application>
</manifest>
