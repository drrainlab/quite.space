# Copy to keystore.properties (git-ignored) and fill in.
#
# THE KEY ITSELF NEVER LIVES IN THIS REPOSITORY. Make it yourself:
#
#   keytool -genkeypair -v -keystore ~/keys/quiet-release.jks -alias quiet \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# AND KEEP IT. An apk signed by a different key is a different app to Android:
# it cannot update an existing install, and the node inside the old one — its
# identity, its spaces, its history — becomes unreachable. Losing this file is
# losing every tester's data.
storeFile=/absolute/path/to/quiet-release.jks
storePassword=
keyAlias=quiet
keyPassword=
