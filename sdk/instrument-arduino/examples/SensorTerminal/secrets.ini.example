; Wi-Fi credentials for the QI-B1 bearer and its TLS spike.
;
; Copy to secrets.ini (git-ignored) and fill in. The password never
; lives in this repository and never rides argv: PlatformIO reads the
; file and folds the values into build flags at compile time.
;
; ESP32 radios speak 2.4 GHz only — a 5 GHz-only network is invisible
; to the board, and the failure looks like a wrong password. Name the
; 2.4 GHz SSID here.
[wifi]
ssid = your-2.4ghz-network
pass = your-password
